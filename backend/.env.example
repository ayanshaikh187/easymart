# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Frontend URL (CORS + Stripe redirect URLs)
CLIENT_URL=http://localhost:5173

# ---------- MongoDB ----------
# Local:  mongodb://127.0.0.1:27017/easymart
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/easymart
MONGO_URI=mongodb://127.0.0.1:27017/easymart
# ---------- JWT ----------
# Koi bhi lamba random string (min 32 chars)
JWT_SECRET=0a7aab565159d11ae0797194fcc05784bedf791e18dad1fd308fea084f480857

# ---------- Stripe ----------
# https://dashboard.stripe.com/test/apikeys  (sk_test_...)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
# `stripe listen --forward-to localhost:5000/api/payments/webhook` chalane par milta hai (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# usd, pkr, eur ... (frontend "$" dikhata hai, isliye default usd)
STRIPE_CURRENCY=usd

# ---------- Email (Forgot Password) - optional ----------
# Agar SMTP set nahi hai to reset link backend terminal me print ho jayega
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EasyMart <no-reply@easymart.com>
